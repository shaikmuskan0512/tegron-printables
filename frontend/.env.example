# API base URL. Leave as /api in development (Vite proxies it to the backend).
# In production set the full backend URL, e.g. https://api.tegronprintables.com/api
VITE_API_URL=/api

# Currency used to display prices
VITE_CURRENCY=USD

# Social links — only the ones you fill in are shown in the site footer/hero.
VITE_ETSY_URL=
VITE_INSTAGRAM_URL=
VITE_PINTEREST_URL=
VITE_YOUTUBE_URL=
VITE_CONTACT_EMAIL=
